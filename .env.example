# Base URL including the /fog prefix (servers[0].url in swagger.json)
FOG_URL=https://fog.example.lan/fog
# API token issued from a user's API tab (fog_ prefix), sent as "Authorization: Bearer"
FOG_API_TOKEN=fog_xxxxxxxxxxxxxxxx
# PEM CA bundle that signed the FOG certificate (self-signed setups)
FOG_CA_BUNDLE=/etc/ssl/fog-ca.pem
# 1 = verify TLS (default). 0 disables verification: lab use only.
FOG_VERIFY_TLS=1
# 1 = register assign_image / create_task / cancel_task (default 0, read-only)
FOG_MCP_ALLOW_WRITE=0
# Task type IDs flagged as destructive in confirmation summaries
FOG_MCP_DESTRUCTIVE_TASK_TYPES=1,2,8,15,16,17,18,19,20
# HTTP timeout in seconds
FOG_TIMEOUT=30
